# Environment Configuration Example
# Copy this file to .env and fill in real values for production

# App Settings
PROJECT_NAME="Field Intelligence App for Native Plants"
API_V1_STR="/api/v1"
DEMO_MODE=true
ENVIRONMENT=development

# Database Settings (PostgreSQL default or SQLite for local quick dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/native_plants_db
# SQLite local fallback example:
# DATABASE_URL=sqlite+aiosqlite:///./native_plants.db

# API Keys (Keep secret - NEVER expose to frontend)
PLANTNET_API_KEY=your_plantnet_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Origins (comma separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://10.0.2.2:8000,*
